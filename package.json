{
	"name": "interlinked-action",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"description": "GitHub Action that flags agent-written PR descriptions",
	"author": "Matteo Gabriele <m.gabriele.dev@gmail.com>",
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write",
		"release": "bumpp"
	},
	"dependencies": {
		"@unveil/interlinked": "^0.0.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.1.1",
		"bumpp": "^11.1.0",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2"
	}
}
